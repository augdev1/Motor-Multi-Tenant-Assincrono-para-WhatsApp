# ==============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - MOTOR MULTI-TENANT PARA WHATSAPP
# ==============================================================================
# Renomeie este arquivo para .env na VPS em /opt/whatsapp-engine/.env
# Gere senhas fortes e únicas para cada serviço.

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS RELACIONAL E VETORIAL (POSTGRESQL + PGVECTOR)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres_prod_user
POSTGRES_PASSWORD=gere_uma_senha_muito_segura_aqui_ex_a8F923jLkM09
POSTGRES_DB=whatsapp_engine_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. CACHE, FILAS E LOCKS DISTRIBUÍDOS (REDIS)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. GATEWAY WHATSAPP (EVOLUTION API V2)
# ------------------------------------------------------------------------------
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.1.2
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=gere_um_token_alfanumerico_seguro_minimo_32_chars
WEBHOOK_URL=http://api:8000/webhook/evolution

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL E VISÃO COMPUTACIONAL (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Chave obtida no Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_real_do_gemini_aqui

# ------------------------------------------------------------------------------
# 5. SEGURANÇA DE BORDA, FILAS ASSÍNCRONAS E ALERTAS ATIVOS
# ------------------------------------------------------------------------------
# Tokens secretos para proteger o endpoint de webhook e rotas administrativas
WEBHOOK_SECRET=gere_um_segredo_webhook_forte_minimo_32_chars
ADMIN_API_KEY=gere_uma_chave_admin_forte_minimo_32_chars
# Habilita processamento desacoplado via fila Redis + Worker dedicado
ASYNC_QUEUE_ENABLED=true
# URL opcional (Slack, Discord, n8n) para alertas push de desconexão WhatsApp
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. DOMÍNIOS PÚBLICOS E PROXY REVERSO COM SSL AUTOMÁTICO (CADDY)
# ------------------------------------------------------------------------------
# Aponte as entradas DNS tipo A de ambos os subdomínios para o IP público da VPS
DOMAIN_API=api.seudominio.com
DOMAIN_EVOLUTION=evo.seudominio.com
ACME_EMAIL=seu_email@seudominio.com

